{
  "rewrites": [
    { "source": "/tools/bill", "destination": "https://jiejourneys-bill.vercel.app" },
    { "source": "/tools/bill/(.*)", "destination": "https://jiejourneys-bill.vercel.app/$1" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:path+/index.html", "destination": "/:path+/", "permanent": true },
    { "source": "/contact/", "destination": "/contact.html", "permanent": true },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jiejourneys.com" }],
      "destination": "https://www.jiejourneys.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/tools/bill", "destination": "https://jiejourneys-bill.vercel.app" },
    { "source": "/tools/bill/(.*)", "destination": "https://jiejourneys-bill.vercel.app/$1" }
  ]
}

{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:path+/index.html", "destination": "/:path+/", "permanent": true },
    { "source": "/contact/", "destination": "/contact", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/busan/video.html", "destination": "/busan/video", "permanent": true },
    { "source": "/busan/hotel.html", "destination": "/busan/hotel", "permanent": true },
    { "source": "/busan/ticket.html", "destination": "/busan/ticket", "permanent": true },
    { "source": "/busan/transport.html", "destination": "/busan/transport", "permanent": true },
    { "source": "/northvietnam/video.html", "destination": "/northvietnam/video", "permanent": true },
    { "source": "/northvietnam/hotel.html", "destination": "/northvietnam/hotel", "permanent": true },
    { "source": "/northvietnam/ticket.html", "destination": "/northvietnam/ticket", "permanent": true },
    { "source": "/northvietnam/transport.html", "destination": "/northvietnam/transport", "permanent": true },
    { "source": "/tokyo/video.html", "destination": "/tokyo/video", "permanent": true },
    { "source": "/tokyo/hotel.html", "destination": "/tokyo/hotel", "permanent": true },
    { "source": "/tokyo/ticket.html", "destination": "/tokyo/ticket", "permanent": true },
    { "source": "/tokyo/transport.html", "destination": "/tokyo/transport", "permanent": true },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jiejourneys.com" }],
      "destination": "https://www.jiejourneys.com/$1",
      "permanent": true
    }
  ]
}
